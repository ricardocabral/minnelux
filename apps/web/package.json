{
  "name": "@minnelux/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:browser": "playwright test",
    "serve:session": "node session/server.mjs",
    "test:session": "node --test session/*.test.mjs && vite build --mode session-test && playwright test --config playwright.session.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@noble/hashes": "2.4.0",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
